<?php
/**
 * @file
 * Tests for the Feeds Comment Processor module.
 */

/**
 * Basic behavior tests for feeds_comment_processor.
 *
 * Tests use the Feeds test helper methods provided by the Feeds module's own
 * test base class (FeedsWebTestCase), which is declared in
 * feeds/tests/feeds_web_test_case.inc and included via feeds.tests.info.
 * Helper methods used:
 *   createImporterConfiguration($label, $id)
 *   setPlugin($id, $class)
 *   setSettings($id, $plugin, $settings)
 *   addMappings($id, $mappings)
 *   removeMappings($id, $mappings)
 *   createFeedNode($id, $url, $title)
 */
class FeedsCommentProcessorWebTest extends FeedsWebTestCase {

  /**
   * Modules to enable.
   *
   * @var array
   */
  public static $modules = array(
    'feeds_comment_processor',
    'feeds',
    'feeds_ui',
    'comment',
    'node',
    'user',
  );

  /**
   * {@inheritdoc}
   */
  public static function getInfo() {
    return array(
      'name'        => 'Feeds Comment Processor',
      'description' => 'Tests for creating and updating comments via Feeds.',
      'group'       => 'Feeds',
    );
  }

  /**
   * {@inheritdoc}
   */
  public function setUp() {
    parent::setUp();

    // Create an admin user with all permissions needed.
    $this->adminUser = $this->backdropCreateUser(array(
      'administer feeds',
      'administer nodes',
      'administer comments',
      'access administration pages',
    ));
    $this->backdropLogin($this->adminUser);

    // Create a standalone importer configuration.
    $this->createImporterConfiguration('Comment import', 'comment_import');

    // Set plugins.
    $this->setPlugin('comment_import', 'FeedsFileFetcher');
    $this->setPlugin('comment_import', 'FeedsCSVParser');
    $this->setPlugin('comment_import', 'FeedsCommentProcessor');

    // Configure the processor - use 'post' which is Backdrop's default type.
    $this->setSettings('comment_import', 'FeedsCommentProcessor', array(
      'input_format' => 'plain_text',
    ));

    // Set up standard mappings used by most tests.
    $this->addMappings('comment_import', array(
      0 => array(
        'source' => 'guid',
        'target' => 'guid',
        'unique' => TRUE,
      ),
      1 => array(
        'source' => 'guid',
        'target' => 'nid_by_guid',
      ),
      2 => array(
        'source' => 'title',
        'target' => 'subject',
      ),
      3 => array(
        'source' => 'body',
        'target' => 'comment_body',
        'format' => 'plain_text',
      ),
      4 => array(
        'source' => 'status',
        'target' => 'status',
      ),
      5 => array(
        'source' => 'hostname',
        'target' => 'hostname',
      ),
      6 => array(
        'source' => 'author',
        'target' => 'author',
      ),
      7 => array(
        'source' => 'email',
        'target' => 'email',
      ),
      8 => array(
        'source' => 'created',
        'target' => 'created',
      ),
    ));

    // Create a parent node using entity_create() and entity_save(), which is
    // the correct Backdrop API for programmatic entity creation.
    $node = entity_create('node', array(
      'type'   => 'post',
      'title'  => 'Parent post',
      'status' => 1,
      'uid'    => $this->adminUser->uid,
    ));
    entity_save('node', $node);
    $this->parentNid = $node->nid;

    db_insert('feeds_item')->fields(array(
      'guid'        => '10',
      'url'         => '',
      'entity_type' => 'node',
      'entity_id'   => $node->nid,
      'feed_nid'    => 0,
      'id'          => 'comment_import',
      'hash'        => '',
      'import_time' => REQUEST_TIME,
      'url'         => '',
    ))->execute();
  }

  /**
   * Helper: return the full path to a test CSV file.
   *
   * @param string $filename
   *   File name within the tests/ subdirectory.
   *
   * @return string
   *   Absolute filesystem path.
   */
  protected function csvPath($filename) {
    return backdrop_get_path('module', 'feeds_comment_processor') . '/tests/' . $filename;
  }

  /**
   * Tests a basic anonymous comment import.
   *
   * Verifies that subject, body, status, created date, and hostname are all
   * saved correctly. The hostname workaround (db_update after comment_save()
   * to correct the value overwritten by CommentStorageController::preSave())
   * is implicitly tested here.
   */
  public function testBasicImport() {
    $this->importFile('comment_import', $this->csvPath('test.csv'));
    $this->assertText('Created 1 comment');

    $comment = comment_load(1, TRUE);
    $this->assertNotNull($comment, 'Comment was created.');
    $this->assertEqual($this->parentNid, $comment->nid,
      'Comment is attached to the correct node.');
    $this->assertEqual('test subject', $comment->subject,
      'Comment subject is correct.');
    $this->assertEqual('test body text',
      $comment->comment_body[LANGUAGE_NONE][0]['value'],
      'Comment body value is correct.');
    $this->assertEqual('plain_text',
      $comment->comment_body[LANGUAGE_NONE][0]['format'],
      'Comment body format is correct.');
    $this->assertEqual(1, $comment->status,
      'Comment is published.');
    $this->assertEqual('192.168.1.100', $comment->hostname,
      'Comment hostname is correctly preserved (workaround for core bug).');
    $this->assertEqual(1388534400, $comment->created,
      'Comment created date is correct.');
    $this->assertEqual(0, $comment->uid,
      'Anonymous comment has uid = 0.');
    $this->assertEqual('anonymous commenter', $comment->name,
      'Anonymous commenter name is stored correctly.');
    $this->assertEqual('anon@example.com', $comment->mail,
      'Anonymous commenter email is stored correctly.');
  }

  /**
   * Tests that a registered user is correctly resolved from the author column.
   *
   * Verifies that entityValidate() performs user_load_by_name() on the mapped
   * author value and sets uid correctly. This must happen in entityValidate()
   * because Feeds calls that method before setTargetElement(), so the lookup
   * cannot be done in setTargetElement() itself.
   */
  public function testRegisteredUserResolution() {
    // Create a user account whose name matches the CSV 'author' column.
    $account = $this->backdropCreateUser(
      array('post comments', 'skip comment approval'),
      'testuser'
    );

    $this->importFile('comment_import', $this->csvPath('test_registered.csv'));
    $this->assertText('Created 1 comment');

    $comment = comment_load(1, TRUE);
    $this->assertNotNull($comment, 'Comment was created.');
    $this->assertEqual($account->uid, $comment->uid,
      'Registered user uid is correctly resolved from author name.');
    $this->assertEqual($account->name, $comment->name,
      'Comment name matches the registered user account name.');
    $this->assertEqual('', $comment->mail,
      'Mail is empty for registered user comments.');
    $this->assertEqual('192.168.1.102', $comment->hostname,
      'Hostname is correctly preserved for registered user comment.');
  }

  /**
   * Tests that an anonymous commenter name is stored when no account matches.
   *
   * Verifies the fallback path in entityValidate() when user_load_by_name()
   * and user_load_by_mail() both return nothing.
   */
  public function testAnonymousAuthorFallback() {
    $this->importFile('comment_import', $this->csvPath('test.csv'));
    $this->assertText('Created 1 comment');

    $comment = comment_load(1, TRUE);
    $this->assertEqual(0, $comment->uid,
      'No uid set for unknown author.');
    $this->assertEqual('anonymous commenter', $comment->name,
      'Anonymous display name stored from author column.');
    $this->assertEqual('anon@example.com', $comment->mail,
      'Anonymous email stored from email column.');
  }

  /**
   * Tests authorization: a user without 'post comments' cannot import.
   */
  public function testAuthorize() {
    // Create a user without 'post comments' permission.
    $account = $this->backdropCreateUser(array(), 'restricteduser');

    // Create a CSV with this user as the author.
    $csv_path = 'temporary://test_auth.csv';
    $csv = "guid,title,body,status,hostname,author,email,created\n";
    $csv .= "10,auth test,auth body,1,127.0.0.1,restricteduser,restricted@example.com,1388534400\n";
    file_put_contents($csv_path, $csv);

    $this->importFile('comment_import', $csv_path);
    $this->assertText('Failed importing 1 comment');
    $this->assertText('is not permitted to post comments');
    $this->assertEqual(0,
      db_query('SELECT COUNT(*) FROM {comment}')->fetchField(),
      'No comment created for unauthorized user.');
  }

  /**
   * Tests mapping node by title instead of guid.
   */
  public function testMappingByTitle() {
    // Replace nid_by_guid with nid_by_title.
    $this->removeMappings('comment_import', array(
      1 => array(
        'source' => 'guid',
        'target' => 'nid_by_guid',
      ),
    ));
    $this->addMappings('comment_import', array(
      9 => array(
        'source' => 'title',
        'target' => 'nid_by_title',
      ),
    ));

    // Create a CSV using node title for lookup.
    $csv_path = 'temporary://test_by_title.csv';
    $csv = "guid,title,body,status,hostname,author,email,created\n";
    $csv .= "10,test subject,test body text,1,192.168.1.100,anonymous commenter,anon@example.com,1388534400\n";
    file_put_contents($csv_path, $csv);

    $this->importFile('comment_import', $csv_path);
    $this->assertText('Created 1 comment');

    $comment = comment_load(1, TRUE);
    $this->assertEqual($this->parentNid, $comment->nid,
      'Comment attached to correct node via title lookup.');
  }

  /**
   * Tests threaded comment import using pid_by_guid.
   *
   * Imports a parent comment, then imports a child comment with pid_by_guid
   * pointing to the parent's guid. Verifies that the thread value is set
   * correctly for the reply.
   */
  public function testThreadedComment() {
    // Add guid and pid_by_guid mappings.
    $this->addMappings('comment_import', array(
      9 => array(
        'source' => 'parent_guid',
        'target' => 'pid_by_guid',
      ),
    ));

    // First import: the parent comment.
    $this->importFile('comment_import', $this->csvPath('test.csv'));
    $this->assertText('Created 1 comment');

    $parent = comment_load(1, TRUE);
    $this->assertNotNull($parent, 'Parent comment created.');
    $this->assertEqual(0, $parent->pid, 'Parent comment has pid = 0.');

    // Second import: the threaded reply.
    $this->importFile('comment_import', $this->csvPath('test2.csv'));
    $this->assertText('Created 1 comment');

    $child = comment_load(2, TRUE);
    $this->assertNotNull($child, 'Child comment created.');
    $this->assertEqual(1, $child->pid,
      'Child comment pid points to parent.');
    $this->assertEqual($this->parentNid, $child->nid,
      'Child comment attached to correct node.');
    // Thread value should be a sub-thread of the parent.
    $this->assertNotEqual($parent->thread, $child->thread,
      'Child comment has different thread value from parent.');
  }

  /**
   * Tests that missing nid causes a validation exception.
   */
  public function testMissingNid() {
    // Remove the nid_by_guid mapping so no nid is provided.
    $this->removeMappings('comment_import', array(
      1 => array(
        'source' => 'guid',
        'target' => 'nid_by_guid',
      ),
    ));

    $this->importFile('comment_import', $this->csvPath('test.csv'));
    $this->assertText('Failed importing 1 comment');
    $this->assertText('No Node ID');
    $this->assertEqual(0,
      db_query('SELECT COUNT(*) FROM {comment}')->fetchField(),
      'No comment created when nid is missing.');
  }

  /**
   * Tests that comments are not created for disabled content types.
   */
  public function testDisabledComments() {
    // Disable comments on the 'post' content type using the correct Backdrop
    // config entity API.
    $node_type = node_type_load('post');
    $node_type->settings['comment_default'] = COMMENT_NODE_HIDDEN;
    entity_save('node_type', $node_type);

    $this->importFile('comment_import', $this->csvPath('test.csv'));
    $this->assertText('Failed importing 1 comment');
    $this->assertEqual(0,
      db_query('SELECT COUNT(*) FROM {comment}')->fetchField(),
      'No comment created when comments are hidden on content type.');

    // Re-enable comments.
    $node_type->settings['comment_default'] = COMMENT_NODE_OPEN;
    entity_save('node_type', $node_type);
  }

  /**
   * Tests that importing the same CSV twice does not create duplicates.
   *
   * The 'guid' target is mapped as unique, so re-importing the same source
   * should update rather than create a new comment.
   */
  public function testNoDuplicatesOnReimport() {
    $this->importFile('comment_import', $this->csvPath('test.csv'));
    $this->assertText('Created 1 comment');

    $this->importFile('comment_import', $this->csvPath('test.csv'));
    $this->assertText('Updated 1 comment');

    $this->assertEqual(1,
      db_query('SELECT COUNT(*) FROM {comment}')->fetchField(),
      'No duplicate comment created on re-import.');
  }

}
