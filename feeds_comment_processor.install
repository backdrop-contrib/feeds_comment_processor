<?php
/**
 * @file
 * Install and update functions for feeds_comment_processor.module.
 */

/**
 * Implements hook_enable().
 *
 * Clear the Feeds plugin cache so the Comment processor appears immediately
 * after the module is enabled without requiring a manual cache flush.
 */
function feeds_comment_processor_enable() {
  // Backdrop uses the cache API with named bins. The Feeds module stores its
  // plugin registry in the default 'cache' bin under this key.
  cache()->delete('plugins:feeds:plugins');
}
