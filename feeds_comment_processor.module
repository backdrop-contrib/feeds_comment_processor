<?php
/**
 * @file
 * Provides a comment entity processor for Feeds.
 */

/**
 * Implements hook_feeds_plugins().
 */
function feeds_comment_processor_feeds_plugins() {
  // Explicitly load class file here to ensure plugin is available when Feeds
  // needs it. Backdrop class registry via files[] in the .info file not enough.
  module_load_include('inc', 'feeds_comment_processor', 'FeedsCommentProcessor');

  $info = array();
  $info['FeedsCommentProcessor'] = array(
    'name' => 'Comment processor',
    'description' => 'Create and update comments from feed items.',
    'help' => 'Import comments and attach them to existing nodes via Node ID (nid).',
    'module' => 'feeds_comment_processor',
    'handler' => array(
      'parent' => 'FeedsProcessor',
      'class' => 'FeedsCommentProcessor',
      'file' => 'FeedsCommentProcessor.inc',
      'path' => backdrop_get_path('module', 'feeds_comment_processor'),
    ),
    'entity_type' => 'comment',
  );
  return $info;
}

/**
 * Implements hook_init().
 *
 * Ensure FeedsCommentProcessor class is loaded early enough that Backdrop's
 * form API can deserialize the form state during AJAX callbacks. Without this,
 * the AJAX callback for the mapping settings cogwheel fails with a fatal error:
 * "tried to execute a method on an incomplete object" because the class
 * definition is not available when unserialize() is called on the form state.
 */
function feeds_comment_processor_init() {
  module_load_include('inc', 'feeds_comment_processor', 'FeedsCommentProcessor');
}

/**
 * Implements hook_feeds_processor_targets_alter().
 *
 * When the Feeds module resolves mapping targets for the 'comment' entity type
 * it needs a valid bundle to load field definitions. We supply the prefixed
 * bundle name ('comment_node_<type>') derived from the first available content
 * type so field targets can be discovered correctly.
 *
 * The actual per-comment bundle is always set dynamically in
 * FeedsCommentProcessor::entityValidate() once the target node is loaded.
 */
function feeds_comment_processor_feeds_processor_targets_alter(&$targets, $entity_type, &$bundle) {
  if ($entity_type !== 'comment') {
    return;
  }

  // If a valid prefixed bundle is already set, leave it alone.
  if (!empty($bundle) && strpos($bundle, 'comment_node_') === 0) {
    return;
  }

  // Derive the bundle from the first available content type.
  $types = node_type_get_types();
  if ($types) {
    $first = key($types);
    $bundle = 'comment_node_' . $first;
  }
}

/**
 * Implements hook_mail_alter().
 *
 * Cancels comment_notify emails while a Feeds comment import is in progress.
 *
 * _comment_notify_mailalert() runs during hook_comment_insert() for any
 * comment with a mapped subscription type (notify > 0), regardless of the
 * $comment->notified value set in FeedsCommentProcessor::entitySave(). This
 * means historical comments imported via Feeds can trigger real "new comment"
 * or "subscription confirmed" emails to real recipients — not appropriate for
 * a bulk historical import.
 *
 * feeds_comment_processor_importing() is toggled around comment_save() in
 * FeedsCommentProcessor::entitySave(). When set, this hook cancels delivery
 * of any comment_notify mail by setting $message['send'] = FALSE.
 *
 * Note: this prevents the email from being delivered, but does not suppress
 * the "Array to string conversion" notice or the watchdog('comment_notify',
 * 'Notified: ...') log entry — both occur during message construction inside
 * _comment_notify_mailalert(), before this hook is invoked. See the upstream
 * comment_notify issue for those.
 */
function feeds_comment_processor_mail_alter(&$message) {
  if ($message['module'] == 'comment_notify' && feeds_comment_processor_importing()) {
    $message['send'] = FALSE;
  }
}

/**
 * Gets or sets a static flag indicating a Feeds comment import is in progress.
 *
 * @param bool|null $set
 *   If TRUE or FALSE, sets the flag to that value. If NULL (default), only
 *   returns the current value without changing it.
 *
 * @return bool
 *   The current value of the flag.
 */
function feeds_comment_processor_importing($set = NULL) {
  $importing = &backdrop_static(__FUNCTION__, FALSE);
  if (isset($set)) {
    $importing = $set;
  }
  return $importing;
}

/**
 * Callback to set the comment body field value.
 *
 * Follows Feeds callback ($source, $entity, $target, $value, $mapping)
 *
 * @param FeedsSource $source
 *   The feeds source.
 * @param object $entity
 *   The comment entity being built.
 * @param string $target
 *   The target field name.
 * @param mixed $value
 *   The value to set.
 * @param array $mapping
 *   The full mapping array, which may contain additional configuration such as
 *   the text format to use.
 */
function feeds_comment_processor_set_comment_body_target(FeedsSource $source, $entity, $target, $value, array $mapping) {
  $langcode = $entity->langcode ?? LANGUAGE_NONE;

  // Prefer a format specified in the mapping config; fall back to the
  // processor's configured format, then to 'filtered_html'.
  $format = 'filtered_html';
  if (!empty($mapping['format'])) {
    $format = $mapping['format'];
  }
  elseif ($source->importer->processor instanceof FeedsCommentProcessor) {
    $config = $source->importer->processor->config;
    if (!empty($config['input_format'])) {
      $format = $config['input_format'];
    }
  }

  $entity->comment_body[$langcode][0] = array(
    'value'  => $value,
    'format' => $format,
  );
}
