<?php
/**
 * @file
 * Provides a comment entity processor for Feeds.
 */

/**
 * Implements hook_feeds_plugins().
 */
function feeds_comment_processor_feeds_plugins() {
  // Explicitly load the include file before defining the plugin.
  module_load_include('inc', 'feeds_comment_processor', 'FeedsCommentProcessor');

  $info = array();

  $info['FeedsCommentProcessor'] = array(
    'name' => 'Comment processor',
    'description' => 'Create and update comments from feed items.',
    'help' => 'Import comments and attach them to existing nodes via Node ID (nid).',
    'module' => 'feeds_comment_processor',
    'handler' => array(
      'parent' => 'FeedsProcessor',
      'class' => 'FeedsCommentProcessor',
      'file' => 'FeedsCommentProcessor.inc',
      'path' => backdrop_get_path('module', 'feeds_comment_processor'),
    ),
    'entity_type' => 'comment',
  );

  return $info;
}

/**
 * Implements hook_feeds_processor_targets_alter() for feeds comment processor.
 *
 * Force bundle to a valid node type to prevent "Missing bundle property" error.
 * Comments need a valid node type as their bundle.
 * Set this to a content type that exists on the site.
 *
 * This may indicate an issue with the main Feeds module that may need fixing.
 */
function feeds_comment_processor_feeds_processor_targets_alter(&$targets, $entity_type, &$bundle) {
  if ($entity_type == 'comment') {
    $bundle = 'page';
  }
}

/**
 * Callback to set the comment body value.
 */
function feeds_comment_processor_set_comment_body_target($comment, $target_name, $value, $source, $importer, $processor) {
  if (!isset($comment->comment_body)) {
    $comment->comment_body = array();
  }

  $langcode = isset($comment->language) ? $comment->language : LANGUAGE_NONE;

  $format = isset($processor->config['input_format']) ? $processor->config['input_format'] : 'filtered_html';

  $comment->comment_body[$langcode][0] = array(
    'value' => $value,
    'format' => $format,
  );
}
